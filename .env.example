# OpenAI API Key (Required for LLM tool calling and responses)
OPENAI_API_KEY=your_openai_api_key_here

# Deepgram API Key (Optional: for streaming STT. If omitted, built-in fallback/browser STT is used)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ElevenLabs API Key (Optional: for premium streaming TTS. If omitted, Edge-TTS streaming is used)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=true

# Model Configuration
OPENAI_MODEL=gpt-4o-mini
