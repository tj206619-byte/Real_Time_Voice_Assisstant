# Google Gemini API Key (Recommended for LLM reasoning and tool calling)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# OpenAI API Key (Alternative LLM provider)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Deepgram API Key (Optional: for streaming STT. If omitted, built-in fallback/browser STT is used)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ElevenLabs API Key (Optional: for premium streaming TTS. If omitted, Edge-TTS streaming is used)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=true

